{
  "name": "xiaobao-cloud",
  "productName": "小豹桌宠",
  "version": "4.1.0",
  "description": "小豹桌宠 (Xiaobao): a desktop cat that sits on your taskbar, wanders about and naps",
  "homepage": "https://github.com/NorthOuterTowner/xiaobao-cloud",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NorthOuterTowner/xiaobao-cloud.git"
  },
  "private": true,
  "license": "MIT",
  "author": {
    "name": "xiaobao-cloud",
    "email": "NorthOuterTowner@users.noreply.github.com"
  },
  "scripts": {
    "start": "tauri dev",
    "stage": "node scripts/stage-web.mjs",
    "tauri": "tauri",
    "assets": "python tools/build_assets.py",
    "assets:probe": "python tools/build_assets.py --probe",
    "icons": "python tools/build_icons.py && tauri icon build/icon.png --output src-tauri/icons",
    "treat": "python tools/build_treat.py",
    "model": "npm --prefix tools/cat3d run export && node -e \"require('fs').mkdirSync('assets/model',{recursive:true});require('fs').copyFileSync('tools/cat3d/out/desktop-cat.glb','assets/model/desktop-cat.glb')\"",
    "model:shoot": "npm --prefix tools/cat3d run shoot",
    "check:behavior": "node tools/_simulate.mjs",
    "dist": "node scripts/build-installers.mjs",
    "dist:win": "node scripts/build-installers.mjs --win",
    "dist:mac": "node scripts/build-installers.mjs --mac",
    "dist:all": "node scripts/build-installers.mjs --all",
    "pack": "node scripts/build-installers.mjs --dir"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.2"
  }
}
